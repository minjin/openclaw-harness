#!/usr/bin/env python3
# Fake Gemini CLI (optional agent): `gemini -p ... --output-format json`.
import json, sys
a = sys.argv[1:]
if a and a[0] == "--version":
    print("9.9.9"); sys.exit(0)
prompt = a[a.index("-p") + 1]
text = "CONDUCTOR-RULES-V1" if "只回复你的共享规则里" in prompt else "# 报告\n\n" + "研究发现 https://example.com " * 120
print(json.dumps({"response": text, "stats": {}}, ensure_ascii=False))
